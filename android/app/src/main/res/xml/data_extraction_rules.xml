<?xml version="1.0" encoding="utf-8"?>
<!-- Yedekleme ve cihazdan cihaza aktarım (Android 12+; spec D.7): oturum belirteci (güvenli depo),
     önbellek ve bekleyen işlemler (sqflite), fotoğraflar ve tercihler aktarılmaz. Yeni cihazda kullanıcı
     yeniden giriş yapar; bekleyen işlem kopyalanıp iki kez gönderilmez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
